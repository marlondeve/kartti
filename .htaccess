RewriteEngine On
RewriteBase /

# Enrutamiento especial: delegar las solicitudes a /carta/* al front controller
# para habilitar el tracking y servir correctamente `carta/menu.html`
# Esta regla debe ir ANTES de la regla que sirve archivos existentes
# Maneja tanto carta/ como carta/archivo.ext
RewriteRule ^carta/?$ index.php?route=carta/ [QSA,L]
RewriteRule ^carta/(.*)$ index.php?route=carta/$1 [QSA,L]

# Si la petición corresponde a un fichero o directorio existente, servirlo directamente
# EXCEPTO para archivos de carta/ que deben pasar por index.php
RewriteCond %{REQUEST_URI} !^/kartti.com
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Reglas explícitas para recursos estáticos y API (por redundancia)
RewriteRule ^public/(css|js)/.*$ - [L]
RewriteRule ^api/.*$ - [L]
RewriteRule ^uploads/.*$ - [L]

# Redirigir la raíz a index.php con route=landing
RewriteRule ^$ index.php?route=landing [L,QSA]

# Redirigir todas las demás solicitudes a index.php (front controller)
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Headers de seguridad
Header set X-Content-Type-Options "nosniff"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"


# Carta: no guardar en caché (página, JS, CSS, datos)
SetEnvIf Request_URI "^/carta" NO_CACHE
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
Header set Pragma "no-cache" env=NO_CACHE
Header set Expires "0" env=NO_CACHE
RewriteEngine On
RewriteBase /

# Permitir acceso directo a archivos existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Permitir acceso directo a archivos CSS y JS
RewriteRule ^public/css/.*\.css$ - [L]
RewriteRule ^public/js/.*\.js$ - [L]

# Permitir acceso directo a archivos de la API
RewriteRule ^api/.*\.php$ - [L]

# Redirigir la raíz a index.php con route=landing
RewriteRule ^$ index.php?route=landing [L]

# Redirigir todas las demás solicitudes a index.php
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Headers de seguridad
Header set X-Content-Type-Options "nosniff"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"

# Prevenir acceso a archivos .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Prevenir acceso a archivos de configuración
<FilesMatch "^(config\.php|composer\.json|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Permitir acceso a archivos estáticos
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rutas API
RewriteRule ^api/(.*)$ api/$1 [QSA,L]

# Rutas principales
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule> 